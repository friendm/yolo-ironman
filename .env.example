# Copy to .env for local development. Every secret the app reads is listed here.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
SITE_URL=http://localhost:8000
SITE_NAME=COI Network

# Postgres
DATABASE_URL=postgresql://coi:coi@localhost:5432/coi

# Private S3-compatible bucket (AWS S3, Supabase Storage, Cloudflare R2...). Leave S3_BUCKET empty to store files on local disk.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
S3_REGION=

# Twilio SMS. Leave empty to print messages to the log.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Email via Postmark or Resend SMTP. Leave EMAIL_HOST empty to print email to the console.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=COI Network <hello@example.com>
ADMIN_DIGEST_EMAILS=

# Document extraction with Claude. Leave empty to skip extraction (vendors see an empty form).
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-opus-5-5

# Background jobs. Q_SYNC=1 runs tasks inline (default when DJANGO_DEBUG=1).
Q_SYNC=
Q_WORKERS=2
